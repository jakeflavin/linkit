# Firebase web config for linkit, on the shared portfolio-4b9fe project.
#
# These are public identifiers, shipped to every browser in the bundle — not secrets.
# Firestore is protected by firestore.rules, which deliberately allow anonymous read,
# post and vote because linkit has no accounts.
#
# linkit used to have its own linkit-web project; that project is being deleted, so the
# database moved here. Every app now shares one Firestore, which is why linkit's
# collections stay under their own top-level names.
VITE_FIREBASE_API_KEY=AIzaSyBi6vQBFzlMmnHiBhaQUi6H0u1JFtg4zw8
VITE_FIREBASE_AUTH_DOMAIN=portfolio-4b9fe.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=portfolio-4b9fe
VITE_FIREBASE_STORAGE_BUCKET=portfolio-4b9fe.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=225079814159
VITE_FIREBASE_APP_ID=1:225079814159:web:0d8f4c07fd4a5673131b7a
