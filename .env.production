# Firebase web config for the linkit-web project.
#
# These are public identifiers, shipped to every browser in the bundle — not secrets.
# Firestore is protected by firestore.rules, which deliberately allow anonymous read,
# post and vote because linkit has no accounts.
#
# Committed rather than injected from repo secrets: hosting is the portfolio's now, so
# the deploy workflow that supplied them is gone, and a fresh clone should still build.
VITE_FIREBASE_API_KEY=AIzaSyA2kBOJ1VmTt309EMYm9Kno_yHjt_8EP3w
VITE_FIREBASE_AUTH_DOMAIN=linkit-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=linkit-web
VITE_FIREBASE_STORAGE_BUCKET=linkit-web.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=183889908946
VITE_FIREBASE_APP_ID=1:183889908946:web:ba31b53b970fe49ca4490b
