# Firebase web config for the linkit-web project.
# Console → Project settings → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=linkit-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=linkit-web
VITE_FIREBASE_STORAGE_BUCKET=linkit-web.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
